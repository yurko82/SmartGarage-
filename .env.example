# SmartGarage Environment Variables Configuration
# Скопіюйте цей файл як .env: cp .env.example .env
# УВАГА: Ніколи не комітьте файл .env у Git!

# 1. AI / OpenRouter (Маршрутизація та Модель)
# Отримайте ключ на https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_DAILY_BUDGET=1.00
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_TIMEOUT=30.0

# 2. Український голосовий синтез (TTS)
# Доступні провайдери: edge (безкоштовний, без ключа), elevenlabs, heygen
TTS_PROVIDER=edge
TTS_VOICE_ID=uk-UA-PolinaNeural
TTS_FALLBACK_PROVIDER=edge
TTS_MAX_TEXT_LENGTH=500

# Опціональні хмарні провайдери (необхідні лише якщо вибрано TTS_PROVIDER=elevenlabs або heygen):
# Отримайте ключ на https://elevenlabs.io
ELEVENLABS_API_KEY=
# Отримайте ключ на https://heygen.com (діє до 30.11.2026 для Turbo Free)
HEYGEN_API_KEY=

# 3. Telegram Bot
# Отримайте токен бота у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# 4. Адміністрування та Безпека Web / API
# PIN-код адміністратора для вебінтерфейсу та виконання керувальних дій (мін. 4 цифри, не дефолтний)
ADMIN_PIN=

# Секретний ключ Flask для підпису cookie-сесій та генерації CSRF-токенів
# Згенеруйте випадковий 64-символьний рядок: openssl rand -hex 32
FLASK_SECRET_KEY=

# 5. MQTT Брокер (Mosquitto)
MQTT_USER=smartgarage
MQTT_PASSWORD=

# 6. ESP32 Безпека та Керування
# Токен доступу до HTTP API мікроконтролера ESP32 (заголовок X-API-Key)
ESP32_API_KEY=

# 7. Open Interpreter (AI Sandbox)
# За замовчуванням ВИМКНЕНО у production для захисту від довільного виконання коду
ENABLE_OPEN_INTERPRETER=false

# 8. Мережа та Кешування (Опціонально)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
