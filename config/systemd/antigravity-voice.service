[Unit]
Description=Smart Garage Antigravity Voice Listener (WakeWord + Whisper STT)
Documentation=https://github.com/yurko82/SmartGarage
After=network.target sound.target pipewire.service smartgarage.service
Wants=pipewire.service

[Service]
Type=simple
User=%u
Group=%u
WorkingDirectory=%h/AI/SmartGarage
Environment="PYTHONPATH=%h/AI/SmartGarage"
Environment="PYTHONUNBUFFERED=1"
Environment="XDG_RUNTIME_DIR=/run/user/%U"
Environment="PULSE_SERVER=/run/user/%U/pulse/native"
Slice=antigravity-voice.slice
ExecStart=%h/AI/sg-venv/bin/python -m server.voice.service
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
