[Unit]
Description=Smart Garage Infrastructure Server
After=network.target network-online.target

[Service]
Type=simple
User=%u
Group=%u
WorkingDirectory=%h/AI/SmartGarage
Environment="PYTHONPATH=%h/AI/SmartGarage"
Environment="PYTHONUNBUFFERED=1"
ExecStart=%h/AI/OpenInterpreter/venv/bin/python -m server.webapp
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
