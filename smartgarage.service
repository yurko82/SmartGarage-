[Unit]
Description=Smart Garage Infrastructure Server
After=network.target network-online.target

[Service]
Type=simple
WorkingDirectory=%h/AI/SmartGarage
Environment="PYTHONPATH=%h/AI/SmartGarage"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/bin/sg dialout -c "%h/AI/OpenInterpreter/venv/bin/python -m server.webapp"
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
